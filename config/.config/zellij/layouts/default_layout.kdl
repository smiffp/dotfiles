layout {
    default_tab_template {
        pane size=2 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="System" split_direction="vertical" focus=true {
        pane command="btop"
        pane command="lazydocker"
    }
    tab name="General" split_direction="vertical" cwd="/Volumes/dev" {
        pane 
        pane 
        pane
    }
    tab name="Stay" split_direction="vertical" cwd="/Volumes/dev/stayai" {
        pane 
        pane 
        pane
    }
}